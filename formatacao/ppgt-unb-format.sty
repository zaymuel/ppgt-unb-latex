% =========================================================================
% SEÇÃO 2: SISTEMA DE REFERÊNCIAS BIBLIOGRÁFICAS (BIBLATEX COM BIBER)
% =========================================================================
% MOTIVAÇÃO DA MIGRAÇÃO PARA O MOTOR BIBER:
% O BibTeX clássico dependia de arquivos de estilo compilados em C (.bst),
% que não suportavam caracteres UTF-8 de forma nativa e quebravam com nomes
% acentuados e pontuações brasileiras. O Biber lê diretamente o arquivo .bib
% codificado em UTF-8, processa chaves, capitalização e ordenação com precisão
% algorítmica e transfere os dados para o LaTeX via BibLaTeX.
%
% PARÂMETROS DO BIBLATEX CONFORME AS NORMAS DO PPGT (2019/2023):
% - backend=biber   : Utiliza o executável moderno Biber para ordenação.
% - style=authoryear: Adota o sistema institucional de chamada Autor-Data.
% - natbib=true     : Permite o uso direto de \citet, \citep, \cite e aliases clássicos.
% - giveninits=true : Converte prenomes de autores em iniciais maiúsculas (ex: Silva, J. A.).
% - uniquename=init : Desambigua autores com mesmo sobrenome usando a inicial do prenome.
% - maxcitenames=2  : No texto: cita até 2 autores por extenso (Autor1 & Autor2).
% - mincitenames=1  : A partir de 3 autores: primeiro autor seguido de et al.
% - maxbibnames=99  : Na lista bibliográfica: lista todos os autores sem truncar.
% - minbibnames=1   : Garante exibição exaustiva na bibliografia final.
% - dashed=false    : Não substitui autores idênticos consecutivos por travessão (proibido no PPGT).
\RequirePackage[
  backend=biber,
  style=authoryear,
  natbib=true,
  giveninits=true,
  uniquename=init,
  maxcitenames=2,
  mincitenames=1,
  maxbibnames=99,
  minbibnames=1,
  dashed=false
]{biblatex}

% Localização e inclusão automática da base bibliográfica (.bib):
\IfFileExists{bibliografia/referencias.bib}{%
  \addbibresource{bibliografia/referencias.bib}%
}{%
  \IfFileExists{referencias.bib}{%
    \addbibresource{referencias.bib}%
  }{}%
}

% -------------------------------------------------------------------------
% 2.1 Dimensões Físicas e Espaçamento da Bibliografia (Normas PPGT)
% -------------------------------------------------------------------------
\setlength{\bibhang}{1.25cm}             % Recuo especial da 2ª linha (hanging indent) de 1,25 cm
\setlength{\bibitemsep}{12pt}            % Espaçamento exato de 12 pt entre referências sucessivas
\renewcommand*{\bibfont}{\singlespacing} % Espaçamento interlinear simples dentro de cada referência

% -------------------------------------------------------------------------
% 2.2 Ordenação e Delimitadores de Nomes de Autores
% -------------------------------------------------------------------------
% Formatação na bibliografia final: SOBRENOME, Iniciais para TODOS os autores:
\DeclareNameAlias{sortname}{family-given}
\DeclareNameAlias{default}{family-given}

% Delimitadores entre autores: vírgula entre os primeiros e ampersand (&) antes do último:
\DeclareDelimFormat{multinamedelim}{\addcomma\space}
\DeclareDelimFormat{finalnamedelim}{\addspace\&\space}
\DeclareDelimFormat[bib,biblist]{finalnamedelim}{\addspace\&\space}

% Padrão textual do "et al." em itálico e prefixo de páginas sempre "p." (sem "pp.") para o PPGT:
\DefineBibliographyStrings{brazilian}{%
  andothers = {\textit{et\addabbrvspace al\adddot}},%
  page      = {p\adddot},%
  pages     = {p\adddot},%
}
\DefineBibliographyStrings{english}{%
  page      = {p\adddot},%
  pages     = {p\adddot},%
}

% Pontuação entre ano e título na bibliografia (PPGT: sem ponto final após o ano):
\DeclareDelimFormat[bib,biblist]{nametitledelim}{\addspace}
\renewcommand*{\labelnamepunct}{\addspace}

% Títulos de artigos e trabalhos em anais sem aspas (padrão PPGT):
\DeclareFieldFormat[article,inproceedings,incollection,inbook]{title}{#1}

% Paginação sempre com prefixo "p." único (ex: p. 215-224), nunca "pp.":
\DeclareFieldFormat{pages}{p\adddot\addnbspace #1}

% Formatação de volume e número/fascículo para periódicos (Normas PPGT: v. X (Y)):
\DeclareFieldFormat[article,periodical]{volume}{v\adddot\addnbspace #1}
\DeclareFieldFormat[article,periodical]{number}{\mkbibparens{#1}}

% Delimitador entre nome do periódico e volume (adiciona vírgula antes de "v. X (Y)"):
\renewbibmacro*{journal+issuetitle}{%
  \usebibmacro{journal}%
  \setunit*{\addcomma\space}%
  \iffieldundef{series}
    {}
    {\newunit
     \printfield{series}%
     \setunit*{\addcomma\space}}%
  \usebibmacro{volume+number+eid}%
  \setunit{\addspace}%
  \usebibmacro{issue+date}%
  \setunit{\addcolon\space}%
  \usebibmacro{issue}%
  \newunit}

\renewbibmacro*{volume+number+eid}{%
  \printfield{volume}%
  \setunit*{\addspace}%
  \printfield{number}%
  \setunit{\addcomma\space}%
  \printfield{eid}}

% Remove o prefixo "In:" para artigos publicados em revistas/periódicos:
\renewbibmacro*{in:}{%
  \ifentrytype{article}{}{%
    \bibstring{in}%
    \printunit{\intitlepunct}%
  }%
}

% -------------------------------------------------------------------------
% 2.3 Controle de Capitalização dos Sobrenomes dos Autores (Regra Estrita PPGT)
% -------------------------------------------------------------------------
% O PPGT exige estritamente:
% - Na Bibliografia: Sobrenome sempre em MAIÚSCULAS (ex: CUNHA, A. B. L. N. & SETTI, J. R.)
% - Citações Parentéticas (\citep, \parencite, \cite): Sobrenome em MAIÚSCULAS (ex: CUNHA & SETTI, 2006)
% - Citações Textuais Narrativas (\citet, \textcite): Iniciais em maiúsculo (ex: Cunha & Setti, 2006)
\newtoggle{ft@uppercase@family}
\togglefalse{ft@uppercase@family}

\renewcommand*{\mkbibnamefamily}[1]{%
  \iftoggle{ft@uppercase@family}{\MakeUppercase{#1}}{#1}%
}

\AtBeginBibliography{%
  \toggletrue{ft@uppercase@family}%
  \setlength{\bibhang}{1.25cm}%
  \setlength{\bibitemsep}{12pt}%
  \singlespacing%
}

\renewbibmacro*{cite}{%
  \toggletrue{ft@uppercase@family}%
  \iffieldundef{shorthand}
    {\ifboolexpr{test {\ifnameundef{labelname}}
                 or test {\iffieldundef{labelyear}}}
       {\usebibmacro{cite:label}%
        \setunit{\printdelim{nonameyeardelim}}}
       {\printnames{labelname}%
        \setunit{\printdelim{nameyeardelim}}}%
     \usebibmacro{cite:labeldate+extradate}}
    {\usebibmacro{cite:shorthand}}}

\renewbibmacro*{textcite}{%
  \togglefalse{ft@uppercase@family}%
  \ifnameundef{labelname}
    {\iffieldundef{shorthand}
       {\usebibmacro{cite:label}%
        \setunit{%
          \global\booltrue{cbx:parens}%
          \printdelim{nonameyeardelim}\bibopenparen}%
        \ifnumequal{\value{citecount}}{1}
          {\usebibmacro{prenote}}
          {}%
        \usebibmacro{cite:labeldate+extradate}}
       {\usebibmacro{cite:shorthand}}}
    {\printnames{labelname}%
     \setunit{%
       \global\booltrue{cbx:parens}%
       \printdelim{nameyeardelim}\bibopenparen}%
     \ifnumequal{\value{citecount}}{1}
       {\usebibmacro{prenote}}
       {}%
     \usebibmacro{citeyear}}}

