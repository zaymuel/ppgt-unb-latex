% Extração automática de dia, mês e ano a partir do formato ISO (AAAA-MM-DD):
\def\dianum{\the\day}
\def\mesnum{\the\month}
\def\anonome{\the\year}
\def\mesnome{%
  \ifcase\mesnum\or
    Janeiro\or Fevereiro\or Março\or Abril\or Maio\or Junho\or
    Julho\or Agosto\or Setembro\or Outubro\or Novembro\or Dezembro\fi
}

\def\ft@parse@iso@date#1-#2-#3\@nil{%
  \def\anonome{#1}%
  \def\mesnum{\number#2}%
  \def\dianum{\number#3}%
}

\renewcommand{\date}[1]{%
  \gdef\@date{#1}%
  \in@{-}{#1}%
  \ifin@
    \ft@parse@iso@date#1\@nil
  \fi
}

