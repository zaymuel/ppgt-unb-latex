% =========================================================================
% SEÇÃO 10: FORMATAÇÃO DE CAPÍTULOS E SEÇÕES (NORMAS PPGT)
% =========================================================================
% Cabeçalho de capítulo numerado (14pt, negrito, centralizado):
\def\@makechapterhead#1{%
  \vspace*{0pt}%
  {\parindent \z@ \centering \normalfont\fontsize{14}{16}\selectfont\bfseries
    \ifnum \c@secnumdepth >\m@ne
      \if@inappendix
        \appendixname\ \thechapter\ \textendash\ %
      \else
        \if@inanexos
          \appendixname\ \thechapter\ \textendash\ %
        \else
          \thechapter\quad
        \fi
      \fi
    \fi
    \interlinepenalty\@M
    #1\par\nobreak
    \vskip 40\p@
  }}

% Cabeçalho de capítulo não numerado (ex: Resumo, Referências):
\def\@makeschapterhead#1{%
  \vspace*{0pt}%
  {\parindent \z@ \centering
    \normalfont
    \interlinepenalty\@M
    \fontsize{14}{16}\selectfont\bfseries  #1\par\nobreak
    \vskip 40\p@
  }}

% Definição unificada do comando \@chapter:
\def\@chapter[#1]#2{%
  \ifnum \c@secnumdepth >\m@ne
    \if@mainmatter
      \refstepcounter{chapter}%
      \typeout{\@chapapp\space\thechapter.}%
      \if@inappendix
        \addcontentsline{toc}{chapter}{\appendixname\ \thechapter\ \textendash\ #1}%
      \else
        \if@inanexos
          \addcontentsline{toc}{chapter}{\appendixname\ \thechapter\ \textendash\ #1}%
        \else
          \addcontentsline{toc}{chapter}{\protect\numberline{\thechapter}#1}%
        \fi
      \fi
    \else
      \addcontentsline{toc}{chapter}{#1}%
    \fi
  \else
    \addcontentsline{toc}{chapter}{#1}%
  \fi
  \chaptermark{#1}%
  \addtocontents{lof}{\protect\addvspace{10\p@}}%
  \addtocontents{lot}{\protect\addvspace{10\p@}}%
  \if@twocolumn
    \@topnewpage[\@makechapterhead{#2}]%
  \else
    \@makechapterhead{#2}%
    \@afterheading
  \fi
}

