% =========================================================================
% SEÇÃO 4: MOTOR DE DUAS PASSADAS (.AUX) PARA FICHA CATALOGRÁFICA
% =========================================================================
% Este bloco resolve automaticamente a quantidade de páginas pré-textuais
% (em algarismos romanos, ex: "xiii") e a quantidade de páginas totais
% (em algarismos arábicos, ex: "142 p.") exibidas na Ficha Catalográfica.
\newif\ifft@manual@pretextual
\ft@manual@pretextualfalse
\def\ft@pretextual@pages{xiii} % Valor inicial padrão antes da primeira leitura do .aux

\def\ft@save@pretextual@pages#1{%
  \ifft@manual@pretextual\else
    \gdef\ft@pretextual@pages{#1}%
  \fi
}

\def\ft@set@pretextual#1{%
  \ft@manual@pretextualtrue
  \gdef\ft@pretextual@pages{#1}%
}

% Permite tanto uso como valor (\paginaspretextuais,) 
% quanto definição manual (\paginaspretextuais{xii} ou \setpaginaspretextuais{xii})
\newcommand{\paginaspretextuais}{%
  \@ifnextchar\bgroup{\ft@set@pretextual}{\ft@pretextual@pages}%
}
\newcommand{\setpaginaspretextuais}[1]{\ft@set@pretextual{#1}}

% Gravação do total de páginas pré-textuais no .aux na transição para o corpo principal:
\def\ft@record@pretextual{%
  \ifx\ft@pretextual@recorded\@undefined
    \global\let\ft@pretextual@recorded\@empty
    \if@openright\cleardoublepage\else\clearpage\fi
    \edef\ft@last@roman{\romannumeral\numexpr\c@page-1\relax}%
    \if@filesw
      \immediate\write\@auxout{\string\ft@save@pretextual@pages{\ft@last@roman}}%
    \fi
  \fi
}

% Gancho em \mainmatter para capturar a virada das páginas preliminares:
\@ifundefined{mainmatter}{}{%
  \let\ft@orig@mainmatter\mainmatter
  \renewcommand{\mainmatter}{%
    \ft@record@pretextual
    \ft@orig@mainmatter
  }%
}

% Gancho para chamadas manuais de \pagenumbering{arabic}:
\let\ft@orig@pagenumbering\pagenumbering
\renewcommand{\pagenumbering}[1]{%
  \def\ft@temp@arabic{arabic}%
  \def\ft@temp@arg{#1}%
  \ifx\ft@temp@arabic\ft@temp@arg
    \ft@record@pretextual
  \fi
  \ft@orig@pagenumbering{#1}%
}

% Cálculo das páginas totais (arábicas):
\def\ft@total@pages{1} % Valor padrão inicial

\def\ft@save@total@pages#1{%
  \gdef\ft@total@pages{#1}%
}

\newcommand{\totalpgsstr}{\ft@total@pages}

\AtEndDocument{%
  \clearpage % Descarrega todas as figuras e tabelas flutuantes pendentes
  \if@filesw
    \edef\ft@last@page{\the\numexpr\c@page-1\relax}%
    \immediate\write\@auxout{\string\ft@save@total@pages{\ft@last@page}}%
  \fi
}

