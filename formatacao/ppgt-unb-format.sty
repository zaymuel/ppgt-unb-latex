\def\ultimosobrenomeautorstr{}
\def\prenomesautorstr{}

% Nome completo configurado obrigatoriamente a partir de prenomes e último sobrenome
\newcommand{\nomecompletoautor}{\prenomesautorstr\ \ultimosobrenomeautorstr}

% Define @author a partir de \nomecompletoautor
\def\ft@define@author{%
  \gdef\@author{\nomecompletoautor}%
}

\newcommand{\ultimosobrenomeautor}[1]{%
  \def\ultimosobrenomeautorstr{#1}%
