% -------------------------------------------------------------------------
% Cálculo das páginas pré-textuais da Ficha Catalográfica
% -------------------------------------------------------------------------
\newif\ifft@manual@pretextual
\ft@manual@pretextualfalse
\def\ft@pretextual@pages{xiii} % Valor padrão inicial antes da leitura do .aux

\def\ft@save@pretextual@pages#1{%
  \ifft@manual@pretextual\else
    \gdef\ft@pretextual@pages{#1}%
  \fi
}

\def\ft@set@pretextual#1{%
  \ft@manual@pretextualtrue
  \gdef\ft@pretextual@pages{#1}%
}

% Permite tanto uso como valor (\paginaspretextuais,) 
% quanto definição manual (\paginaspretextuais{xii} ou \setpaginaspretextuais{xii})
\newcommand{\paginaspretextuais}{%
  \@ifnextchar\bgroup{\ft@set@pretextual}{\ft@pretextual@pages}%
}
\newcommand{\setpaginaspretextuais}[1]{\ft@set@pretextual{#1}}

% Gravação do número de páginas pré-textuais no arquivo .aux
\def\ft@record@pretextual{%
  \ifx\ft@pretextual@recorded\@undefined
    \global\let\ft@pretextual@recorded\@empty
    \if@openright\cleardoublepage\else\clearpage\fi
    \edef\ft@last@roman{\romannumeral\numexpr\c@page-1\relax}% <-- Correção: -1 adicionado aqui
    \if@filesw
      \immediate\write\@auxout{\string\ft@save@pretextual@pages{\ft@last@roman}}%
    \fi
  \fi
}

% Hook em \mainmatter
\@ifundefined{mainmatter}{}{%
  \let\ft@orig@mainmatter\mainmatter
  \renewcommand{\mainmatter}{%
    \ft@record@pretextual
    \ft@orig@mainmatter
  }%
}

% Hook em \pagenumbering para quando \pagenumbering{arabic} for chamado diretamente
\let\ft@orig@pagenumbering\pagenumbering
\renewcommand{\pagenumbering}[1]{%
  \def\ft@temp@arabic{arabic}%
  \def\ft@temp@arg{#1}%
  \ifx\ft@temp@arabic\ft@temp@arg
    \ft@record@pretextual
  \fi
  \ft@orig@pagenumbering{#1}%
}

