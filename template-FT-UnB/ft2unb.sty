    Julho\or Agosto\or Setembro\or Outubro\or Novembro\or Dezembro\fi
}

\def\ft@parse@iso@date#1-#2-#3\@nil{%
  \def\anonome{#1}%
  \def\mesnum{\number#2}%
  \def\dianum{\number#3}%
}

\renewcommand{\date}[1]{%
  \gdef\@date{#1}%
  % Verifica se está no formato ISO (YYYY-MM-DD)
  \in@{-}{#1}%
  \ifin@
    \ft@parse@iso@date#1\@nil
  \fi
}

