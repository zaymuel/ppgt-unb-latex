  \fi
}

% Extração de iniciais dos prenomes (ex: João da Silva -> J. S.)
\newcommand{\iniciais}[1]{%
  \@for\ft@elem:=#1\do{%
    \ifx\ft@elem\@empty\else
      \expandafter\ft@check@particle\ft@elem\@nil
    \fi
  }%
}

\def\ft@check@particle#1\@nil{%
  \ifthenelse{%
    \equal{#1}{da}\OR\equal{#1}{de}\OR\equal{#1}{do}\OR%
    \equal{#1}{das}\OR\equal{#1}{dos}\OR\equal{#1}{e}\OR%
    \equal{#1}{Da}\OR\equal{#1}{De}\OR\equal{#1}{Do}\OR%
    \equal{#1}{Das}\OR\equal{#1}{Dos}\OR\equal{#1}{E}%
  }{%
    % Partículas conectivas são ignoradas nas iniciais
  }{%
    \MakeUppercase{\expandafter\@car#1\@nil}.\space
  }%
}

% Iniciais dos prenomes do autor (utiliza \prenomesautorstr ou inicial do autor)
\newcommand{\iniciaisautor}{%
  \ifx\prenomesautorstr\@empty
    \MakeUppercase{\expandafter\@car\@author\@nil}.%
  \else
    \iniciais{\prenomesautorstr}%
  \fi
}

% Nome do autor para a Referência Bibliográfica: SOBRENOME, I. N.
\newcommand{\autorreferenciabibliografica}{%
  \ifx\ultimosobrenomeautorstr\@empty
    \MakeUppercase{\begingroup\def\\{, }\@author\endgroup}%
  \else
    \MakeUppercase{\ultimosobrenomeautorstr}, \iniciaisautor
  \fi
}

